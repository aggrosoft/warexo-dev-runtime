#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Usage: warexo-checkout <branch|tag|commit>" >&2
    exit 2
fi

cd /var/www/html
ref="$1"

git fetch origin --prune
git checkout "$ref" || git checkout --detach "$ref"

# The vendor package is built separately; never run Composer in the Git tree.
/opt/warexo/bin/install-vendors

# Regenerate runtime-only cache, but keep any tracked cache placeholders.
if [ -f app/console ]; then
    sudo -u developer -H php app/console cache:warmup --env=prod || true
fi

echo "Warexo is now on: $(git rev-parse --short HEAD)"
