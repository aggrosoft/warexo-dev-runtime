#!/usr/bin/env bash
set -euo pipefail

: "${WAREXO_GIT_URL:?WAREXO_GIT_URL is required}"
WAREXO_GIT_REF="${WAREXO_GIT_REF:-master}"

if [ -n "$(find /var/www/html -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    echo "/var/www/html is not empty; refusing initial clone" >&2
    exit 1
fi

export GIT_SSH_COMMAND="ssh -i /home/developer/.ssh/id_ed25519 -o IdentitiesOnly=yes -o PasswordAuthentication=no -o BatchMode=yes -o CheckHostIP=no"

if [ -s /home/developer/.ssh/known_hosts ]; then
    export GIT_SSH_COMMAND="$GIT_SSH_COMMAND -o UserKnownHostsFile=/home/developer/.ssh/known_hosts -o StrictHostKeyChecking=yes"
fi

echo "Cloning Warexo repository from configured Git remote..."
sudo -u developer -H env GIT_SSH_COMMAND="$GIT_SSH_COMMAND" git clone "$WAREXO_GIT_URL" /var/www/html

cd /var/www/html
sudo -u developer -H env GIT_SSH_COMMAND="$GIT_SSH_COMMAND" git fetch origin --prune
sudo -u developer -H env GIT_SSH_COMMAND="$GIT_SSH_COMMAND" git checkout "$WAREXO_GIT_REF" \
    || sudo -u developer -H env GIT_SSH_COMMAND="$GIT_SSH_COMMAND" git checkout --detach "$WAREXO_GIT_REF"

chown -R developer:www-data /var/www/html
